# ============================================================
# 云端部署环境变量模板
# 复制为 .env 后填写实际值
# ⚠️  .env 包含敏感信息，严禁提交到 Git
# ============================================================

# Oracle 数据库密码
ORACLE_PASSWORD=change-me-to-a-strong-password

# JWT 签名密钥（至少 32 位随机字符串）
JWT_KEY=change-me-to-a-random-string-at-least-32-chars-long

# 内部服务调用密钥
SERVICE_KEY=change-me-to-a-service-key

# Docker 镜像仓库（默认 ghcr.io/你的GitHub用户名）
DOCKER_REGISTRY=ghcr.io/keith-hq

# 镜像标签（默认 latest）
API_TAG=latest
WEB_TAG=latest
