# ============================================================
# 前端 Vue 3 SPA 镜像（多阶段：Node 构建 → Nginx 静态服务）
# 自包含构建：无需预置 dist/ 产物，有源码即可构建
# 构建命令：docker build -t dorm-web:latest -f deploy/docker/Dockerfile.frontend .
# 国内网络加速：--build-arg NPM_REGISTRY=https://registry.npmmirror.com
# ============================================================

# ---- 阶段 1：Node 构建 ----
FROM node:20-alpine AS build
WORKDIR /app

# 默认官方源；中国大陆构建时通过 --build-arg 覆盖
ARG NPM_REGISTRY=https://registry.npmjs.org

# 先只拷贝依赖清单（仅清单变化才重新 npm ci，利用层缓存）
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --registry=$NPM_REGISTRY

# 拷贝源码并生产构建（node_modules/.env 由 .dockerignore 排除）
COPY frontend/ ./
RUN npm run build

# ---- 阶段 2：Nginx 静态服务 ----
FROM nginx:1.27-alpine

# 设置时区
ENV TZ=Asia/Shanghai
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# 从构建阶段复制前端产物
COPY --from=build /app/dist/ /usr/share/nginx/html/

# 复制前端容器内的 Nginx 配置
COPY deploy/docker/nginx.conf /etc/nginx/conf.d/default.conf

# 验证 Nginx 配置语法
# 证书文件在运行时由 compose 挂载 ../nginx/certs 提供；构建期复制占位证书
# （deploy/docker/nginx-certs-placeholder/，仅用于 nginx -t 校验通过，
#   运行时挂载会整体覆盖 /etc/nginx/certs 目录；避免 apk add 依赖境外源）
COPY deploy/docker/nginx-certs-placeholder/ /etc/nginx/certs/
RUN nginx -t

EXPOSE 80 443

# 健康检查必须写死 127.0.0.1：容器内 localhost 先解析为 ::1（IPv6），
# 而 nginx 仅监听 IPv4 → Connection refused → 恒 unhealthy（2026-08-18 实测）
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1:80/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
